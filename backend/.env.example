# ===== 应用配置 =====
DEBUG=true

# ===== OpenAI API 配置 =====
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 模型配置 =====
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ===== 文档处理配置 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== 检索配置 =====
RETRIEVER_TOP_K=10
RERANK_TOP_N=5

# ===== RAG 优化开关 =====
USE_RERANKER=true
USE_QUERY_REWRITE=true
QUERY_REWRITE_NUM=3
